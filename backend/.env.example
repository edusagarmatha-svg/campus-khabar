[TEMPLATE]
# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed by CORS
# (the Vite dev server default is shown).
CORS_ORIGIN=http://localhost:5173

# MySQL 8 connection (used by knexfile.js and the app pool)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campus_kabar
DB_PASSWORD=
DB_NAME=campus_kabar

# Authentication
# Required in production: at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Development falls back to a known, insecure secret if this is empty, so the
# app and Knex CLI run without a .env. Never rely on that fallback in production.
JWT_ACCESS_SECRET=

# Token lifetimes. Access tokens are short-lived JWTs; refresh tokens are
# opaque, rotated on every use, and stored hashed in MySQL.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Refresh-token cookie. Secure defaults to true in production; SameSite
# defaults to lax, which works for localhost:5173 -> localhost:4000 because
# both are the same site (ports are not part of the site).
# Use SameSite=none only together with Secure=true, cross-site cookies, and a
# CSRF strategy. COOKIE_DOMAIN lets the cookie be shared with an API subdomain.
COOKIE_NAME=ck_refresh
COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Express "trust proxy" setting, required behind a reverse proxy so rate
# limiting sees the client IP and Secure cookies work with TLS termination.
# Accepts true/false, a hop count, or a comma-separated list (e.g. loopback).
TRUST_PROXY=false

# Cloudinary media storage (required in production for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix; environment segment (dev/test/prod) is appended.
# CLOUDINARY_UPLOAD_FOLDER=campus-kabar
