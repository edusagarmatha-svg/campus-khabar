# Copy to .env and fill in real values. Never commit .env.
# Keep the real file at mode 600: chmod 600 backend/.env
# Production refuses to start if .env is group- or world-accessible.

# Runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed by CORS
# (the Vite dev server default is shown). Production requires explicit HTTPS
# origins; localhost and plain HTTP origins are rejected.
CORS_ORIGIN=http://localhost:5173

# Canonical public site origin used by robots.txt and sitemap.xml.
# Development falls back to http://localhost:5173; production requires an
# explicit HTTPS origin with no trailing slash.
PUBLIC_SITE_URL=http://localhost:5173

# MySQL 8 connection (used by knexfile.js and the app pool).
# DB_HOST is required in production; do not rely on the development default.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campus_kabar
DB_PASSWORD=
DB_NAME=campus_kabar

# TLS for a managed/remote MySQL server. Local development can leave this off.
# Production refuses to start when DB_HOST is not localhost and DB_SSL is false.
# A *.railway.internal host is exempt: that traffic stays on Railway's
# per-project private network, which the managed database does not expose over
# TLS. Any other remote host must still set DB_SSL=true.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM files for providers that require a private CA or client cert.
# DB_SSL_CA=/etc/campus-kabar/mysql-ca.pem
# DB_SSL_CERT=/etc/campus-kabar/mysql-client-cert.pem
# DB_SSL_KEY=/etc/campus-kabar/mysql-client-key.pem

# Authentication
# Required in production: at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Development falls back to a known, insecure secret if this is empty, so the
# app and Knex CLI run without a .env. Never rely on that fallback in production.
JWT_ACCESS_SECRET=

# Token lifetimes. Access tokens are short-lived JWTs; refresh tokens are
# opaque, rotated on every use, and stored hashed in MySQL.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Refresh-token cookie. Secure defaults to true in production and cannot be
# disabled there. SameSite defaults to lax, which works for localhost:5173 ->
# localhost:4000 because both are the same site (ports are not part of the site).
# Use SameSite=none only together with Secure=true, cross-site cookies, and a
# CSRF strategy. COOKIE_DOMAIN lets the cookie be shared with an API subdomain.
COOKIE_NAME=ck_refresh
COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Express "trust proxy" setting, required behind a reverse proxy so rate
# limiting sees the client IP and Secure cookies work with TLS termination.
# Accepts true/false, a hop count, or a comma-separated list (e.g. loopback).
TRUST_PROXY=false

# Authentication rate limits. Production defaults are 10 login attempts and
# 100 auth requests per 15-minute window. Invalid values abort startup.
# LOGIN_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_MAX=100
# Development-only kill switch; ignored in production.
# RATE_LIMIT_DISABLED=true

# Media storage (persistent volume)
# The mount point of the volume that holds uploaded media. Two directories are
# created under it: media/ (served at /uploads) and tmp/ (in-flight uploads,
# never served). Required in production and must be writable, or the API
# refuses to start. Development falls back to backend/var/storage.
# On Railway this is the volume's mount path, e.g. /data.
MEDIA_STORAGE_PATH=

# Built frontend bundle served by this process at the same origin as the API.
# Defaults to ../frontend/dist, which is correct for a local checkout; the
# container image sets it explicitly. When the directory is absent the API
# still serves /api, robots.txt and sitemap.xml.
# FRONTEND_DIST_PATH=
